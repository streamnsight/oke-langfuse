# Copy this file to tests/.env and fill in real values for local fixture deployment.
# These values stay outside git and are automatically loaded by tests/scripts/run.sh.

# OCI CLI profile used by Terraform, OCI CLI, and obc.
export OCI_PROFILE="DEFAULT"
export TF_VAR_oci_profile="DEFAULT"

# Shared tenancy and compartment values
export TF_VAR_region="us-chicago-1"
export TF_VAR_tenancy_ocid="ocid1.tenancy.oc1..example"
export TF_VAR_vcn_compartment_id="ocid1.compartment.oc1..example"
export TF_VAR_cluster_compartment_id="ocid1.compartment.oc1..example"
export TF_VAR_devops_compartment_id="ocid1.compartment.oc1..example"
export TF_VAR_secrets_store_vault_compartment_id="ocid1.compartment.oc1..example"
export TF_VAR_compartment_id="$TF_VAR_vcn_compartment_id"

# Vault inputs used by the stack
export TF_VAR_secrets_store_vault_id="ocid1.vault.oc1..example"
export TF_VAR_secrets_store_key_id="ocid1.key.oc1..example"

# Stack inputs needed by the test fixtures and stack deploys
export TF_VAR_langfuse_s3_access_key="replace-me"
export TF_VAR_langfuse_s3_secret_key="replace-me"
export TF_VAR_identity_domain_id="ocid1.domain.oc1..example"
export TF_VAR_ssh_public_key="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ...you@example"
export TF_VAR_fixture_node_image_id="ocid1.image.oc1.us-chicago-1.example"

# Enable non-sensitive metadata outputs for the test harness.
export TF_VAR_test_mode="true"

# Optional defaults for fixture/debug flows
# export NAMESPACE="langfuse"
export OBC_ROOT_DIR="$(pwd)/tests/.obc"
# Runtime DevOps identifiers are discovered from terraform output -json or debug artifacts.
# Keep these only as manual overrides when inspecting a specific deployment.
# export PROJECT_ID="ocid1.devopsproject.oc1..example"
# export PIPELINE_ID="ocid1.devopsdeploypipeline.oc1..example"
# export DEPLOYMENT_ID="ocid1.devopsdeployment.oc1..example"
